{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thedailybutler.com/content/v1/schema.json",
  "title": "DailyButlerContent",
  "description": "Public content v1. Unknown fields are allowed for additive backwards-compatible changes.",
  "oneOf": [
    { "$ref": "#/$defs/Manifest" },
    { "$ref": "#/$defs/Catalog" },
    { "$ref": "#/$defs/Reader" },
    { "$ref": "#/$defs/Site" }
  ],
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Url": { "type": "string", "format": "uri", "pattern": "^https://[^/]+/" },
    "Day": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "ReadingId": { "type": "string", "pattern": "^butler-benziger-1894-en:[0-9]{2}-[0-9]{2}$" },
    "Document": {
      "type": "object", "required": ["url", "sha256", "bytes"],
      "properties": {
        "url": { "$ref": "#/$defs/Url" },
        "sha256": { "$ref": "#/$defs/Hash" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 20000000 }
      }
    },
    "Manifest": {
      "type": "object",
      "required": ["kind", "schema_version", "content_version", "episode_count", "reading_count", "documents"],
      "properties": {
        "kind": { "const": "manifest" }, "schema_version": { "const": 1 },
        "content_version": { "$ref": "#/$defs/Hash" },
        "episode_count": { "type": "integer", "minimum": 0 },
        "reading_count": { "const": 366 },
        "documents": {
          "type": "object", "required": ["catalog", "reader", "site"],
          "properties": {
            "catalog": { "$ref": "#/$defs/Document" },
            "reader": { "$ref": "#/$defs/Document" },
            "site": { "$ref": "#/$defs/Document" }
          }
        }
      }
    },
    "Image": {
      "type": "object", "required": ["url", "sha256", "bytes", "width", "height", "mime_type"],
      "properties": {
        "url": { "$ref": "#/$defs/Url" }, "sha256": { "$ref": "#/$defs/Hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
        "mime_type": { "const": "image/webp" }
      }
    },
    "Episode": {
      "type": "object",
      "required": ["id", "date", "reading_id", "title", "display_title", "published_at", "website_url", "notes", "audio", "video", "artwork", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "reading_id": { "$ref": "#/$defs/ReadingId" },
        "title": { "type": "string", "minLength": 1 }, "display_title": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" },
        "website_url": { "$ref": "#/$defs/Url" }, "notes": { "type": "string" },
        "revision": { "$ref": "#/$defs/Hash" },
        "audio": {
          "type": "object", "required": ["url", "mime_type", "duration_seconds", "bytes", "sha256"],
          "properties": {
            "url": { "$ref": "#/$defs/Url" }, "mime_type": { "const": "audio/mpeg" },
            "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "anyOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] }
          }
        },
        "video": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "required": ["provider", "id", "url"],
              "properties": {
                "provider": { "const": "youtube" },
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
                "url": { "$ref": "#/$defs/Url" }
              }
            }
          ]
        },
        "artwork": {
          "type": "object", "required": ["landscape", "square"],
          "properties": {
            "landscape": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Image" } },
            "square": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Image" } }
          }
        }
      }
    },
    "Catalog": {
      "type": "object", "required": ["kind", "schema_version", "episodes"],
      "properties": {
        "kind": { "const": "catalog" }, "schema_version": { "const": 1 },
        "episodes": { "type": "array", "items": { "$ref": "#/$defs/Episode" } }
      }
    },
    "Edition": {
      "type": "object", "required": ["id", "title", "publisher", "year", "language", "rights", "calendar_note"],
      "properties": {
        "id": { "const": "butler-benziger-1894-en" }, "title": { "type": "string" },
        "publisher": { "type": "string" }, "year": { "const": 1894 },
        "language": { "const": "en" }, "rights": { "type": "string" }, "calendar_note": { "type": "string" }
      }
    },
    "Block": {
      "type": "object", "required": ["id", "text"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
    },
    "Reading": {
      "type": "object", "required": ["id", "calendar_day", "label", "website_url", "entries", "reading_minutes", "revision"],
      "properties": {
        "id": { "$ref": "#/$defs/ReadingId" }, "calendar_day": { "$ref": "#/$defs/Day" },
        "label": { "type": "string", "minLength": 1 }, "website_url": { "$ref": "#/$defs/Url" },
        "reading_minutes": { "type": "integer", "minimum": 1 }, "revision": { "$ref": "#/$defs/Hash" },
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["heading", "display_heading", "paragraphs", "reflection"],
            "properties": {
              "heading": { "type": "string", "minLength": 1 }, "display_heading": { "type": "string", "minLength": 1 },
              "paragraphs": { "type": "array", "items": { "$ref": "#/$defs/Block" } },
              "reflection": { "anyOf": [{ "$ref": "#/$defs/Block" }, { "type": "null" }] }
            }
          }
        }
      }
    },
    "Reader": {
      "type": "object", "required": ["kind", "schema_version", "edition", "readings"],
      "properties": {
        "kind": { "const": "reader" }, "schema_version": { "const": 1 },
        "edition": { "$ref": "#/$defs/Edition" },
        "readings": { "type": "array", "minItems": 366, "maxItems": 366, "items": { "$ref": "#/$defs/Reading" } }
      }
    },
    "Site": {
      "type": "object", "required": ["kind", "schema_version", "name", "description", "contact_email", "edition", "links"],
      "properties": {
        "kind": { "const": "site" }, "schema_version": { "const": 1 },
        "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" },
        "contact_email": { "const": "info@thedailybutler.com" }, "edition": { "$ref": "#/$defs/Edition" },
        "links": {
          "type": "object", "required": ["website", "about", "youtube", "apple", "spotify", "r2"],
          "properties": {
            "website": { "$ref": "#/$defs/Url" }, "about": { "$ref": "#/$defs/Url" },
            "youtube": { "$ref": "#/$defs/Url" }, "apple": { "$ref": "#/$defs/Url" },
            "spotify": { "$ref": "#/$defs/Url" }, "r2": { "$ref": "#/$defs/Url" }
          }
        }
      }
    }
  }
}
